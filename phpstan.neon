# PHPStan level 6. Installed in CI (see .github/workflows/ci.yml):
#   composer global require phpstan/phpstan:^1.12 szepeviktor/phpstan-wordpress:^1.3 php-stubs/woocommerce-stubs
includes:
	- %env.PHPSTAN_WP_EXTENSION%
parameters:
	level: 6
	paths:
		- src
		- wv-members.php
	scanFiles:
		- vendor/php-stubs/woocommerce-stubs/woocommerce-stubs.php
	bootstrapFiles:
		- tests/phpstan-bootstrap.php
	treatPhpDocTypesAsCertain: false
	reportUnmatchedIgnoredErrors: false
	ignoreErrors:
		- '#has parameter \$\w+ with no value type specified in iterable type array#'
		- '#return type has no value type specified in iterable type array#'
		- '#Function wvm\(\) invoked#'
