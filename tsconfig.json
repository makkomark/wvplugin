{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "lib": ["DOM", "DOM.Iterable", "ES2021"],
    "types": [],
    "baseUrl": ".",
    "paths": { "@shared/*": ["assets/src/shared/*"] }
  },
  "include": ["assets/src/**/*"]
}
