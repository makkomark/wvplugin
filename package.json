{
  "name": "wv-members",
  "version": "1.0.0",
  "private": true,
  "description": "WitsValley Members \u2014 React apps (member dashboard + admin)",
  "scripts": {
    "build": "wp-scripts build",
    "start": "wp-scripts start",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint:js": "wp-scripts lint-js assets/src",
    "test:e2e": "playwright test --trace off",
    "plugin-zip": "bash bin/build-release.sh",
    "build:member": "WVM_ENTRY=member wp-scripts build",
    "build:admin": "WVM_ENTRY=admin wp-scripts build",
    "typecheck:member": "tsc --noEmit -p tsconfig.member.json",
    "typecheck:admin": "tsc --noEmit -p tsconfig.admin.json"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@wordpress/api-fetch": "^7.14.0",
    "@wordpress/components": "^29.0.0",
    "@wordpress/element": "^6.14.0",
    "@wordpress/icons": "^10.14.0",
    "@wordpress/scripts": "^30.7.0",
    "typescript": "^5.7.2"
  }
}
