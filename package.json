{
  "name": "wv-members",
  "version": "1.0.0",
  "private": true,
  "description": "WitsValley Members — React apps (member dashboard + admin)",
  "scripts": {
    "build": "wp-scripts build member=./assets/src/member/index.tsx admin=./assets/src/admin/index.tsx --output-path=build",
    "start": "wp-scripts start member=./assets/src/member/index.tsx admin=./assets/src/admin/index.tsx --output-path=build",
    "typecheck": "tsc --noEmit",
    "lint:js": "wp-scripts lint-js assets/src",
    "test:e2e": "playwright test --trace off",
    "plugin-zip": "bash bin/build-release.sh"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@wordpress/api-fetch": "^7.14.0",
    "@wordpress/components": "^29.0.0",
    "@wordpress/element": "^6.14.0",
    "@wordpress/icons": "^10.14.0",
    "@wordpress/scripts": "^30.7.0",
    "typescript": "^5.7.2"
  }
}
